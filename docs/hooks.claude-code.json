{
  "_comment": "Phase 2 手動安裝用：把 hooks 內容合併進 ~/.claude/settings.json（保留你原有的 Notification / Stop 條目）。Phase 6 會由 app 的安裝器自動做這件事，含備份與 diff。",
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event SessionStart", "timeout": 10 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event SessionEnd", "timeout": 1 }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event UserPromptSubmit", "timeout": 10 }] }],
    "PreToolUse":         [
      { "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event PreToolUse", "timeout": 10 }] },
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event PreToolUse --tool AskUserQuestion", "timeout": 120 }] }
    ],
    "PostToolUse":        [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event PostToolUse", "timeout": 10 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event PostToolUseFailure", "timeout": 10 }] }],
    "PermissionRequest":  [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event PermissionRequest", "timeout": 120 }] }],
    "Notification":       [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event Notification", "timeout": 10 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event Stop", "timeout": 10 }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event StopFailure", "timeout": 10 }] }],
    "SubagentStart":      [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event SubagentStart", "timeout": 10 }] }],
    "SubagentStop":       [{ "hooks": [{ "type": "command", "command": "$HOME/.cubi/bin/cubi-hook --agent claude-code --event SubagentStop", "timeout": 10 }] }]
  }
}
